{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "bacon/bacon-qr-code": "^2.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "darkaonline/l5-swagger": "^8.6",
        "diglactic/laravel-breadcrumbs": "^10.0",
        "fruitcake/laravel-cors": "dev-develop",
        "geoip2/geoip2": "~2.1",
        "google/apiclient": "^2.15",
        "guzzlehttp/guzzle": "^7.4",
        "intervention/image": "^2.5",
        "jenssegers/agent": "^2.6",
        "khaled.alshamaa/ar-php": "^7.0",
        "laravel/framework": "^10.10",
        "laravel/reverb": "^1.5",
        "laravel/sanctum": "^3.3",
        "laravel/socialite": "6.x-dev",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.4",
        "laravelcollective/html": "^6.2",
        "maatwebsite/excel": "^3.1",
        "macsidigital/laravel-zoom": ">=3",
        "microsoft/microsoft-graph": "^1.28",
        "namu/wirechat": "^0.2.10",
        "phpoffice/phpspreadsheet": "^1.29",
        "pragmarx/google2fa-laravel": "^2.3",
        "pusher/pusher-php-server": "^7.2",
        "resend/resend-laravel": "^1.3",
        "sentry/sentry-laravel": "^4.4",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-permission": ">=4",
        "stichoza/google-translate-php": "^5.1",
        "symfony/css-selector": "^6.0",
        "torann/geoip": "^3.0",
        "unisharp/laravel-filemanager": "^2.0"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^1.0",
        "fakerphp/faker": "^1.9.1",
        "filp/whoops": "^2.0",
        "fruitcake/laravel-debugbar": "^3.16",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "disable-tls": false
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/Http/Helpers/Helpers.php",
            "app/Http/Helpers/Breadcrumbs.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
